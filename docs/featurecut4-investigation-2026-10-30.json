    {
      "seq": 54,
      "code": "if model is None or GET(model, \"GetType\") != 1:\n    raise RuntimeError(\"Нужна активная деталь Деталь9.\")\n# Контроль фактического состояния: предыдущие операции не повторяем.\nrequired = {\"Основание_Вытяжка_10мм\", \"Бобышка_Верх_Ø70_Z10_38\", \"Бобышка_Низ_Ø60_Z-37\"}\nexisting = []\nfeat = GET(model, \"FirstFeature\")\nwhile feat is not None:\n    existing.append(GET(feat, \"Name\"))\n    feat = GET(feat, \"GetNextFeature\")\nmissing = sorted(required.difference(existing))\nif missing:\n    raise RuntimeError(\"Ожидаемые завершённые элементы отсутствуют: \" + \", \".join(missing))\nif \"Отверстия_Основание_Ø10_Сквозные\" in existing:\n    raise RuntimeError(\"Этап holes уже выполнен; повторная мутация запрещена.\")\n\n# Эскиз на базовой плоскости Спереди: x=X, y=Y модели, z=0.\nmodel.ClearSelection2(True)\nif not model.Extension.SelectByID2(\"Спереди\", \"PLANE\", 0.0, 0.0, 0.0, False, 0, NOTHING, 0):\n    raise RuntimeError(\"Не удалось выбрать плоскость Спереди.\")\nsm = GET(model, \"SketchManager\")\nif not sm.InsertSketch(True):\n    raise RuntimeError(\"Не удалось открыть эскиз отверстий основания.\")\ncenters = [(15.0, -50.0), (15.0, 50.0), (150.0, -50.0), (150.0, 50.0)]\nsegments = []\nfor x_mm, y_mm in centers:\n    seg = sm.CreateCircleByRadius(MM(x_mm), MM(y_mm), 0.0, MM(5.0))\n    if seg is None:\n        raise RuntimeError(f\"Не создано отверстие в ({x_mm}; {y_mm}) мм.\")\n    segments.append(seg)\n# Диаметральные размеры создаём как управляющие, но геометрия уже задана точным радиусом.\ndim_status = []\nfor i, (seg, (x_mm, y_mm)) in enumerate(zip(segments, centers), 1):\n    model.ClearSelection2(True)\n    if not seg.Select4(False, NOTHING):\n        raise RuntimeError(f\"Не удалось выбрать окружность отверстия {i}.\")\n    try:\n        with DIMENSIONS():\n            dim = model.AddDiameterDimension2(MM(x_mm + 8.0), MM(y_mm + 8.0), 0.0)\n        if dim is not None:\n            d = dim.GetDimension2(0)\n            d.Name = f\"Диаметр_Отверстия_Основания_{i}\"\n            dim_status.append(d.Name)\n        else:\n            dim_status.append(f\"не создан {i}\")\n    except Exception as exc:\n        dim_status.append(f\"пропущен {i}: {exc}\")\nmodel.ClearSelection2(True)\nif not sm.InsertSketch(True):\n    raise RuntimeError(\"Не удалось закрыть эскиз отверстий основания.\")\n\n# Находим только что созданный эскиз в дереве и переименовываем.\nprofiles = []\nfeat = GET(model, \"FirstFeature\")\nwhile feat is not None:\n    if GET(feat, \"GetTypeName2\") == \"ProfileFeature\":\n        profiles.append(feat)\n    feat = GET(feat, \"GetNextFeature\")\nif not profiles:\n    raise RuntimeError(\"Эскиз отверстий основания не найден в дереве.\")\nhole_sketch = profiles[-1]\nhole_sketch.Name = \"Эскиз_Отверстия_Основание_Ø10\"\n\nmodel.ClearSelection2(True)\nif not model.Extension.SelectByID2(\"Эскиз_Отверстия_Основание_Ø10\", \"SKETCH\", 0.0, 0.0, 0.0, False, 0, NOTHING, 0):\n    raise RuntimeError(\"Не удалось выбрать эскиз отверстий для выреза.\")\nfm = GET(model, \"FeatureManager\")\n# swEndCondThroughAll = 1; остальные параметры соответствуют FeatureCut4.\ncut = fm.FeatureCut4(False, False, False, 1, 0, 0.0, 0.0, False, False, False, False, 0.0, 0.0, False, False, False, False, False, False, False, False, False, False, 0, 0.0, False, False)\nif cut is None:\n    raise RuntimeError(\"FeatureCut4 не создал сквозной вырез.\")\ncut.Name = \"Отверстия_Основание_Ø10_Сквозные\"\nif not GET(model, \"EditRebuild3\"):\n    raise RuntimeError(\"Перестроение после отверстий основания завершилось ошибкой.\")\nresult = {\"feature\": cut.Name, \"sketch\": hole_sketch.Name, \"centers_mm\": centers, \"diameter_mm\": 10.0, \"dimension_status\": dim_status}"
    },
    {
      "seq": 95,
      "code": "if model is None or GET(model, \"GetType\") != 1:\n    raise RuntimeError(\"Нужна активная деталь Деталь9.\")\nactive = GET(model, \"GetActiveSketch\")\nif active is None:\n    raise RuntimeError(\"После ошибки не найден активный пустой эскиз; продолжение небезопасно.\")\nsegments_before = GET(active, \"GetSketchSegments\") or ()\nif len(segments_before) != 0:\n    raise RuntimeError(\"Активный эскиз уже содержит геометрию; повторная мутация запрещена.\")\nsm = GET(model, \"SketchManager\")\ncenters = [(15.0, -50.0), (15.0, 50.0), (150.0, -50.0), (150.0, 50.0)]\nsegments = []\nfor x_mm, y_mm in centers:\n    seg = sm.CreateCircleByRadius(MM(x_mm), MM(y_mm), 0.0, MM(5.0))\n    if seg is None:\n        raise RuntimeError(f\"Не создано отверстие в ({x_mm}; {y_mm}) мм.\")\n    segments.append(seg)\n# Окружности созданы в активном эскизе. Вызов без проверки bool: InsertSketch\n# в данной версии SolidWorks возвращает False даже при успешном переключении режима.\nmodel.ClearSelection2(True)\nsm.InsertSketch(True)\n\n# Переименовываем уже существующий пустой Эскиз4, не создавая новый эскиз.\nempty = None\nfeat = GET(model, \"FirstFeature\")\nwhile feat is not None:\n    if GET(feat, \"Name\") == \"Эскиз4\":\n        empty = feat\n        break\n    feat = GET(feat, \"GetNextFeature\")\nif empty is None:\n    raise RuntimeError(\"Исходный пустой Эскиз4 не найден для продолжения.\")\nempty.Name = \"Эскиз_Отверстия_Основание_Ø10\"\n\nmodel.ClearSelection2(True)\nif not model.Extension.SelectByID2(\"Эскиз_Отверстия_Основание_Ø10\", \"SKETCH\", 0.0, 0.0, 0.0, False, 0, NOTHING, 0):\n    raise RuntimeError(\"Не удалось выбрать продолженный эскиз отверстий для выреза.\")\nfm = GET(model, \"FeatureManager\")\n# swEndCondThroughAll = 1; остальные значения по проверенной сигнатуре IFeatureManager.FeatureCut4.\ncut = fm.FeatureCut4(False, False, False, 1, 0, 0.0, 0.0, False, False, False, False, 0.0, 0.0, False, False, False, False, False, False, False, False, False, False, 0, 0.0, False, False)\nif cut is None:\n    raise RuntimeError(\"FeatureCut4 не создал сквозной вырез отверстий основания.\")\ncut.Name = \"Отверстия_Основание_Ø10_Сквозные\"\nif not GET(model, \"EditRebuild3\"):\n    raise RuntimeError(\"Перестроение после отверстий основания завершилось ошибкой.\")\nresult = {\"feature\": cut.Name, \"sketch\": empty.Name, \"centers_mm\": centers, \"diameter_mm\": 10.0, \"segments_created\": len(segments)}"
    },
    {
      "seq": 115,
      "code": "if model is None or GET(model, \"GetType\") != 1:\n    raise RuntimeError(\"Нужна активная деталь Деталь9.\")\n# Продолжение от уже созданного и подтверждённого инспекцией эскиза; геометрию не повторяем.\nmodel.ClearSelection2(True)\nif not model.Extension.SelectByID2(\"Эскиз_Отверстия_Основание_Ø10\", \"SKETCH\", 0.0, 0.0, 0.0, False, 0, NOTHING, 0):\n    raise RuntimeError(\"Не удалось выбрать существующий эскиз отверстий основания.\")\n# Используем IModelDoc2.FeatureCut4: в установленной версии это 17-параметрическая перегрузка.\n# swEndCondThroughAll = 1.\ncut = model.FeatureCut4(False, False, False, 1, 0, 0.0, 0.0, False, False, False, False, 0.0, 0.0, False, False, 0, False)\nif cut is None:\n    raise RuntimeError(\"Исправленная перегрузка IModelDoc2.FeatureCut4 также не создала вырез.\")\ncut.Name = \"Отверстия_Основание_Ø10_Сквозные\"\nif not GET(model, \"EditRebuild3\"):\n    raise RuntimeError(\"Перестроение после отверстий основания завершилось ошибкой.\")\nresult = {\"feature\": cut.Name, \"sketch\": \"Эскиз_Отверстия_Основание_Ø10\", \"diameter_mm\": 10.0, \"end_condition\": \"ThroughAll\"}"
    }
